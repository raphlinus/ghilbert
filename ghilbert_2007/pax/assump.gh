# Absorption theorems. All have the name a<one>a<two>. The second is removed.
# One shorthand I've considered is using a<foo>a for al<foo>ar<foo>.
# Worthwhile?

thm (alar ()
  ((hyp (-> (/\ a a) b)))
  (-> a b)
  (hyp anidms))

thm (allar ()
  ((hyp (-> (/\ (/\ a b) a) c)))
  (-> (/\ a b) c)
  (hyp anabss1))

thm (alrar ()
  ((hyp (-> (/\ (/\ a b) b) c)))
  (-> (/\ a b) c)
  (hyp anabss3))

thm (arall ()
  ((hyp (-> (/\ (/\ a b) a) c)))
  (-> (/\ b a) c)
  (hyp anabss4))

thm (alarl ()
  ((hyp (-> (/\ a (/\ a b)) c)))
  (-> (/\ a b) c)
  (hyp anabss5))

thm (arral ()
  ((hyp (-> (/\ a (/\ b a)) c)))
  (-> (/\ b a) c)
  (hyp anabss7))

thm (allalr ()
  ((hyp (-> (/\ (/\ a a) b) c)))
  (-> (/\ a b) c)
  (hyp anabsan))

thm (allarl ()
  ((hyp (-> (/\ (/\ a b) (/\ a c)) d)))
  (-> (/\ (/\ a b) c) d)
  (hyp 3impdi 3expa
))

thm (alrarr ()
  ((hyp (-> (/\ (/\ a b) (/\ c b)) d)))
  (-> (/\ (/\ a b) c) d)
  (hyp alr-l arrr-l al-lr allalr al-lr
))

# Syllogisms

thm (syl-l ()
  ((hyp1 (-> a b))
   (hyp2 (-> (/\ b c) d)))
  (-> (/\ a c) d)
  (hyp2 hyp1 sylan))

thm (syl-r ()
  ((hyp1 (-> a b))
   (hyp2 (-> (/\ c b) d)))
  (-> (/\ c a) d)
  (hyp1 hyp2 ar-l syl-l al-r))

thm (syl-ll ()
  ((hyp1 (-> a b))
   (hyp2 (-> (/\ (/\ b c) d) e)))
  (-> (/\ (/\ a c) d) e)
  (hyp1 hyp2 all-l syl-l al-ll))

thm (syl-lr ()
  ((hyp1 (-> a b))
   (hyp2 (-> (/\ (/\ c b) d) e)))
  (-> (/\ (/\ c a) d) e)
  (hyp1 hyp2 alr-l syl-l al-lr))

thm (syl-rl ()
  ((hyp1 (-> a b))
   (hyp2 (-> (/\ c (/\ b d)) e)))
  (-> (/\ c (/\ a d)) e)
  (hyp1 hyp2 arl-l syl-l al-rl))

thm (syl-rr ()
  ((hyp1 (-> a b))
   (hyp2 (-> (/\ c (/\ d b)) e)))
  (-> (/\ c (/\ d a)) e)
  (hyp1 hyp2 arr-l syl-l al-rr))

