# E! theorems

stmt (eubidv ((T x) (ph x))
  ((-> ph (<-> ps ch))
   (istype T))
  (-> ph (<-> (E! x T ps) (E! x T ch))))

stmt (eubii ((T x))
  ((<-> ph ps)
   (istype T))
  (<-> (E! x T ph) (E! x T ps)))

stmt (eu4 ((T x y) (ph y) (ps x))
  ((-> (= T (cv x) (cv y)) (<-> ph ps))
   (istype T))
  (<-> (E! x T ph) (/\ (E. x T ph)
                    (A. x T (A. y T (-> (/\ ph ps) (= T (cv x) (cv y))))))))

stmt (eueq ((T x y) (A x y))
  ((istype T))
  (-> (: A T) (E! x T (= T (cv x) A))))


stmt (iotaax2 ((T x y) (ph y))
  ((istype T))
  (-> (E! x T ph) ([:=] x T (iota x T ph) ph)))
stmt (iotaty ((T x y) (ph y))
  ((istype T))
  (-> (E! x T ph) (: (iota x T ph) T)))
stmt (iota-alphaconv ((T x y))
  ((nfi y T ph)
   (nfi x T ps)
   (-> (/\ (: (cv x) T) (: (cv y) T)) (-> (= T (cv x) (cv y)) (<-> ph ps)))
   (istype T))
  (= T (iota x T ph) (iota y T ps)))
stmt (iota-alphaconv-v ((T x y) (ph y) (ps x))
  ((-> (/\ (: (cv x) T) (: (cv y) T)) (-> (= T (cv x) (cv y)) (<-> ph ps)))
   (istype T))
  (= T (iota x T ph) (iota y T ps)))
stmt (iotaeq ((T x y) (ph y) (ps y))
  ((istype T))
  (-> (A. x T (<-> ph ps)) (= T (iota x T ph) (iota x T ps))))
stmt (iotaeqd ((T x) (ph x))
  ((-> ph (<-> ps ch))
   (istype T))
  (-> ph (= T (iota x T ps) (iota x T ch))))
stmt (ifbi ()
  ((istype T))
  (-> (<-> ph ps) (= T (if T ph A B) (if T ps A B))))
stmt (ifeq1 ((T x) (A x) (B x) (C x) (ph x))
  ((istype T))
  (-> (= T A B) (= T (if T ph A C) (if T ph B C))))
stmt (ifeq2 ((T x) (A x) (B x) (C x) (ph x))
  ((istype T))
  (-> (= T A B) (= T (if T ph C A) (if T ph C B))))
stmt (iftrue ((T x) (A x) (B x) (ph x))
  ((istype T))
  (-> (/\ ph (: A T)) (= T (if T ph A B) A)))
stmt (iffalse ((T x) (A x) (B x) (ph x))
  ((istype T))
  (-> (/\ (-. ph) (: B T)) (= T (if T ph A B) B)))


