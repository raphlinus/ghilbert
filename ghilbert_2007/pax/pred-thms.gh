   hyp hypT 19.21aiv
   hypT x ps ch 19.18 syl
))



# I proved the version in which ps is also available for proving the type
# of A, but that really shouldn't be necessary
thm (substex_lem ((T x y) (T' x y) (ph x y) (ps y) (ch x) (A y))
  ((hyp1 (-> (/\ (/\ ph (/\ (= T' (cv y) A) ps)) (/\ (: (cv x) T) (: (cv y) T'))) ch))
   (hyp2 (-> (/\ ph (/\ (: (cv x) T) ps)) (: A T')))
   (hypT (istype T))
   (hypT' (istype T')))
  (-> (/\ ph (E. x T ps)) (E. y T' ch))
  (
   hyp2
   A T' y df-ty sylib exp impac

     hypT' y (= T' (cv y) A) (/\ (: (cv x) T) ps) 19.41v sylibr 

       hypT'
     hyp1 alrl-l arrr-l arrll-l arrrl-l al-rrrr exp32 19.22dv
   com12 syl
   imp allar

   al-ll exp hypT 19.21aiv
     hypT hypT x (E. y T' ch) nfi_dv ps 19.23
   sylib imp
))

# A change of existential quantifiers using implicit substitution
thm (substex ((T x y) (T' x y) (ph x y) (ps y) (ch x) (A y))
  ((hyp1 (-> (/\ (/\ ph (/\ (= T' (cv y) A) ps)) (/\ (: (cv x) T) (: (cv y) T'))) ch))
   (hyp2 (-> (/\ ph (: (cv x) T)) (: A T')))
   (hypT (istype T))
   (hypT' (istype T')))
  (-> (/\ ph (E. x T ps)) (E. y T' ch))
  (hyp1 hyp2 ps adantl al-rr hypT hypT' substex_lem
))

# Substitution.

thm (dfsbcq ((T x z) (A z) (B z) (ph z))
  ((hyp (istype T)))
  (-> (= T A B) (<-> ([:=] x T A ph) ([:=] x T B ph)))
  (
       hyp A B (cv z) eqeq2
     (E. x T (/\ (= T (cv x) (cv z)) ph)) anbi1d
   hyp z exbidv
   hyp x A ph z df-subst
   hyp x B ph z df-subst
   3bitr4g
))

thm (sbcgf ((T x z) (ph z) (A z))
  ((hyp1 (istype T))
   (hyp2 (nfi x T ph)))
  (-> (: A T) (<-> ([:=] x T A ph) ph))
  (
       A T z df-ty
       hyp1 z (= T (cv z) A) ph 19.41v baibr
     sylbi
         hyp1 (cv z) A tyeq1
         (cv z) T x df-ty
       hyp1 hyp2 (= T (cv x) (cv z)) 19.41 baib sylbi
     syl6bir com12 pm5.32d
     hyp1 z exbidv
   bitr4d
   hyp1 x A ph z df-subst syl6rbbr
))

thm (sbc5 ((T x z) (A x z) (ph z))
  ((hyp (istype T)))
  (-> (: A T) (<-> ([:=] x T A ph) (E. x T (/\ (= T (cv x) A) ph))))
  (
   A T z df-ty
     hyp x A ph z df-subst
       hyp (cv z) A (cv x) eqeq2 ph anbi1d
     hyp x exbidv pm5.32i
     hyp z exbii bitr
     hyp z (= T (cv z) A) (E. x T (/\ (= T (cv x) A) ph)) 19.41v
     bitr baib
   sylbi
))

