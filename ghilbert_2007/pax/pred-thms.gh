thm (iotabaz ((T x))
  ((hypT (istype T)))
  (-> (/\ (E! x T ph) (: (cv x) T)) (<-> ph (= T (cv x) (iota x T ph))))
  (
   hypT y ph nfi_dv hypT x eu2 biimp pm3.27d
   hypT hypT x y (-> (/\ ph ([:=] x T (cv y) ph)) (= T (cv x) (cv y))) alcom sylib
     hypT x ph iotaty (iota x T ph) T y df-ty sylib
   jca
     hypT y (A. x T (-> (/\ ph ([:=] x T (cv y) ph)) (= T (cv x) (cv y)))) (= T (cv y) (iota x T ph)) 19.29
   syl

     hypT x ph iotaax2
     hypT (cv y) (iota x T ph) x ph dfsbcq biimprd com12 syl imp

       hypT x (-> (/\ ph ([:=] x T (cv y) ph)) (= T (cv x) (cv y))) spec-var imp3a imp arrr-l exp
     syl imp alr-l
     hypT (cv x) (cv y) (iota x T ph) ax-eqtr exp syl imp allar

     arrl-l al-ll ar-l exp
     (: (cv y) T) adantr hypT 19.21aiv
       hypT hypT y (= T (cv x) (iota x T ph)) nfi_dv (/\ (A. x T (-> (/\ ph ([:=] x T (cv y) ph)) (= T (cv x) (cv y)))) (= T (cv y) (iota x T ph))) 19.23
   sylib com12 syl imp alarl

   arr-l ar-l exp
     hypT x ph iotaax2
       hypT x ph iotaty hypT (iota x T ph) x ph sbceq1 syl
     imp biimprd com12 syl imp alarl exp
     (: (cv x) T) adantr
   impbid
))

thm (Nfi_iotalem ((T x y) (ph y))
  ((hypT (istype T)))
  (-> (/\ (E! x T ph) (: (cv y) T))
    (<-> ([:=] x T (cv y) ph) (= T (cv y) (iota x T ph))))
  (
   hypT y ph nfi_dv hypT x sb8eu
     hypT y ([:=] x T (cv y) ph) iotabaz
       hypT y ph nfi_dv
         hypT x (cv y) ph nfi_sbc
           hypT (cv y) x ph sbceq1 (: (cv x) T) adantl
       hypT iota-alphaconv
       hypT (cv y) eqeq2i
     syl6bbr
   exp sylbi imp
))

# This proves a guarded version of the Nfi axiom, using only iota-ax
# (or, at least, it would, if supporting lemmas didn't use
# iota-alphaconvt).

thm (Nfi_iota_guarded ((T x y) (ph y))
  ((hypT (istype T)))
  (-> (E! x T ph) (A. y T (<-> (= T (cv y) (iota x T ph)) (A. x T (= T (cv y) (iota x T ph))))))
  (
   hypT x ph y Nfi_iotalem

   hypT x (cv y) ph nfi_sbc nfii syl5rbbr

     hypT x ph nfi_boundeu
     hypT x (: (cv y) T) nfi_dv hypT nfi_an
       hypT x ph y Nfi_iotalem
     hypT albid
   bitrd
   hypT 19.21aiv
))

# The "if" operation

thm (ifbi ()
  ((hypT (istype T)))
  (-> (<-> ph ps) (= T (if T ph A B) (if T ps A B)))
  (
   (<-> ph ps) id (= T (cv x) A) anbi2d
     ph ps pm4.11 biimp (= T (cv x) B) anbi2d
   orbi12d
   hypT x iotaeqd
     hypT ph A B x df-if
       hypT ps A B x df-if
   hypT 3eqtr4g
))

thm (ifeq1 ((T x) (A x) (B x) (C x) (ph x))
  ((hyp (istype T)))
  (-> (= T A B) (= T (if T ph A C) (if T ph B C)))
  (
   hyp A B (cv x) eqeq2 ph anbi1d
   (/\ (= T (cv x) C) (-. ph)) orbi1d
   hyp x iotaeqd

     hyp ph A C x df-if
       hyp ph B C x df-if
   hyp 3eqtr4g
))

thm (ifeq2 ((T x) (A x) (B x) (C x) (ph x))
  ((hyp (istype T)))
  (-> (= T A B) (= T (if T ph C A) (if T ph C B)))
  (
   hyp A B (cv x) eqeq2 (-. ph) anbi1d
   (/\ (= T (cv x) C) ph) orbi2d
   hyp x iotaeqd

     hyp ph C A x df-if
       hyp ph C B x df-if
   hyp 3eqtr4g
))

thm (iftrue ((T x) (A x) (B x) (ph x))
  ((hyp (istype T)))
  (-> (/\ ph (: A T)) (= T (if T ph A B) A))
  (
   ph (= T (cv x) A) (= T (cv x) B) dedlema
   hyp x iotaeqd

     hyp A x iotafoo1
   hyp eqtr3a
     hyp ph A B x df-if
   hyp syl5eq
))

thm (iffalse ((T x) (A x) (B x) (ph x))
  ((hyp (istype T)))
  (-> (/\ (-. ph) (: B T)) (= T (if T ph A B) B))
  (
   ph (= T (cv x) B) (= T (cv x) A) dedlemb
   hyp x iotaeqd

     hyp B x iotafoo1
   hyp eqtr3a
     hyp ph A B x df-if
   hyp syl5eq
))

# define "not free in" for values as well as predicates
def ((Nfi x T A) (A. y T (<-> (= T (cv y) A) (A. x T (= T (cv y) A)))))

