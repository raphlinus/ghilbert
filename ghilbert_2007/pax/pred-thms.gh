# Theorems for iota (definite description)

# iota axiom expressed in terms of substitution
thm (iotaax2 ((T x y) (ph y))
  ((hyp (istype T)))
  (-> (E! x T ph) ([:=] x T (iota x T ph) ph))
  (
   hyp x ph y iota-ax
     hyp x (iota x T ph) ph y df-subst
   sylibr
))

thm (iotaty ((T x y) (ph y))
  ((hyp (istype T)))
  (-> (E! x T ph) (: (iota x T ph) T))
  (
   hyp x ph y iota-ax
     hyp
       (= T (cv y) (iota x T ph)) (E. x T (/\ (= T (cv x) (cv y)) ph)) pm3.26
     (: (cv y) T) a1i 19.22i
   syl
     (iota x T ph) T y df-ty
   sylibr
))

thm (iotafoo1 ((T x y) (A x y))
  ((hyp (istype T)))
  (-> (: A T) (= T (iota x T (= T (cv x) A)) A))
  (
   hyp A x eueq
   hyp x (= T (cv x) A) iotaax2 syl
     hyp A x eueq hyp x (= T (cv x) A) iotaty syl
       hyp
         hyp (cv x) (cv y) A eqeq1
         (/\ (: (cv x) T) (: (cv y) T)) a1i
           hyp (cv y) (iota x T (= T (cv x) A)) A eqeq1
           (/\ (: (cv y) T) (: (iota x T (= T (cv x) A)) T)) a1i
       mksbc3
     syl
   mpbid
))

# problematic (depends on iota-alphaconvt)
thm (iota-alphaconv ((T x y))
  ((hyp1 (nfi y T ph))
   (hyp2 (nfi x T ps))
   (hyp3 (-> (/\ (: (cv x) T) (: (cv y) T))
     (-> (= T (cv x) (cv y)) (<-> ph ps))))
   (hypT (istype T)))
  (= T (iota x T ph) (iota y T ps))
  (
   hypT
     hyp3 hypT 19.21aiv
   gen
     
     hypT hyp1 hyp2 iota-alphaconvt
   ax-mp
))

# problematic (depends on iota-alphaconvt)
thm (iota-alphaconv-v ((T x y) (ph y) (ps x))
  ((hyp1 (-> (/\ (: (cv x) T) (: (cv y) T))
     (-> (= T (cv x) (cv y)) (<-> ph ps))))
   (hypT (istype T)))
  (= T (iota x T ph) (iota y T ps))
  (hypT y ph nfi_dv hypT x ps nfi_dv hyp1 hypT iota-alphaconv))

# problematic (depends on iota-alphaconvt)
