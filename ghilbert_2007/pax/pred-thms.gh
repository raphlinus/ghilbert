thm (cbvex ((T x y))
  ((hyp1 (nfi y T ph))
   (hyp2 (nfi x T ps))
   (hyp (-> (/\ (: (cv x) T) (: (cv y) T))
     (-> (= T (cv x) (cv y)) (<-> ph ps))))
   (hypT (istype T)))
  (<-> (E. x T ph) (E. y T ps))
  (
   hyp1 hypT nfi_not
     hyp2 hypT nfi_not
       hyp imp negbid exp
   hypT cbval negbii
     x T ph df-ex
       y T ps df-ex
   3bitr4
))

thm (cbvexv ((T x y) (ph y) (ps x))
  ((hyp (-> (/\ (: (cv x) T) (: (cv y) T))
     (-> (= T (cv x) (cv y)) (<-> ph ps))))
   (hypT (istype T)))
