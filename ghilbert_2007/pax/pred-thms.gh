       (= T (cv x) A) (= T (cv x) B) bi1
       (= T (cv x) A) (= T (cv x) B) pm2.27 com12 syl imp
       (= T (cv x) A) anim2i al-r  alrar
       hypT (cv x) A B eqeq1 biimpa syl
       (: (cv x) T) adantr hypT 19.23aiv

   syl exp com12 sylbi imp
))

