# not used
thm (alim2 ((T x))
  ((hyp (istype T)))
  (-> (A. x T (-> ph (-> ps ch))) (-> (A. x T ph) (-> (A. x T ps) (A. x T ch))))
  (
    hyp x ph (-> ps ch) alim
    hyp x ps ch alim syl6
))

thm (19.15 ((T x))
  ((hyp (istype T)))
  (-> (A. x T (<-> ph ps)) (<-> (A. x T ph) (A. x T ps)))
  (
    hyp ph ps bi1 (: (cv x) T) a1i gen
    hyp x (<-> ph ps) (-> ph ps) alim ax-mp
    hyp x ph ps alim syl

    hyp ph ps bi2 (: (cv x) T) a1i gen
    hyp x (<-> ph ps) (-> ps ph) alim ax-mp 
    hyp x ps ph alim syl impbid
))

thm (19.15i ((T x))
  ((hyp1 (istype T))
   (hyp2 (A. x T (<-> ph ps))))
  (<-> (A. x T ph) (A. x T ps))
  (hyp2 hyp1 x ph ps 19.15 ax-mp))

thm (albii ((T x))
  ((hyp (<-> ph ps))
   (hypT (istype T)))
  (<-> (A. x T ph) (A. x T ps))
  (hypT hypT hyp (: (cv x) T) a1i gen 19.15i))

# should this be primary?
thm (albii2 ((T x))
  ((hyp (-> (: (cv x) T) (<-> ph ps)))
   (hypT (istype T)))
  (<-> (A. x T ph) (A. x T ps))
  (hypT hypT hyp gen 19.15i))

thm (nfii ((T x))
  ((hyp (nfi x T ph)))
  (<-> ph (A. x T ph))
  (hyp x T ph df-nfi mpbi))

thm (nfiir ((T x))
  ((hyp (<-> ph (A. x T ph))))
  (nfi x T ph)
  (hyp x T ph df-nfi mpbir))

# A useful inference for creating nfi's
thm (nfi_fromdef ((T x))
  ((hyp2 (<-> ph ps))
   (hyp3 (nfi x T ps))
   (hypT (istype T)))
  (nfi x T ph)
  (hyp2 hyp3 nfii hyp2 hypT x albii bitr4 bitr nfiir
))

thm (nfi_or ((T x ))
  ((hyp2 (nfi x T ph))
   (hyp3 (nfi x T ps))
   (hyp1 (istype T)))
  (nfi x T (\/ ph ps))
  (
   ph ps df-or
     hyp2 hyp1 nfi_not
       hyp3
     hyp1 nfi_im
   hyp1 nfi_fromdef
))

thm (nfi_an ((T x ))
  ((hyp2 (nfi x T ph))
   (hyp3 (nfi x T ps))
   (hyp1 (istype T)))
  (nfi x T (/\ ph ps))
  (
   ph ps df-an
     hyp2
       hyp3 hyp1 nfi_not hyp1 nfi_im hyp1 nfi_not
   hyp1 nfi_fromdef
))

thm (nfi_bi ((T x ))
  (
   (hyp2 (nfi x T ph))
   (hyp3 (nfi x T ps))
   (hyp1 (istype T)))
  (nfi x T (<-> ph ps))
  (
   ph ps bi
     hyp2 hyp3 hyp1 nfi_im
       hyp3 hyp2 hyp1 nfi_im
   hyp1 nfi_an hyp1 nfi_fromdef
))

thm (nfi_ex ((T x y) (T' x y))
 ((hyp3 (nfi x T ph))
  (hyp1 (istype T))
  (hyp2 (istype T')))
  (nfi x T (E. y T' ph))
  (
   y T' ph df-ex
     hyp3 hyp1 nfi_not hyp1 hyp2 y nfi_al hyp1 nfi_not
   hyp1 nfi_fromdef
))

thm (nfi_boundex ((T x))
  ((hyp (istype T)))
  (nfi x T (E. x T ph))
  (
   x T ph df-ex
     hyp x (-. ph) nfi_bound hyp nfi_not
   hyp nfi_fromdef
))

thm (nfii_ex ((T x))
  ((hyp2 (nfi x T ph))
   (hyp1 (istype T)))
  (<-> ph (E. x T ph))
  (hyp2 hyp1 nfi_not nfii bicon1i bicomi
   x T ph df-ex bitr4
))


thm (mpg ((T x))
  ((mpg.1 (-> (A. x T ph) ps))
   (mpg.2 (-> (: (cv x) T) ph))
   (hypT (istype T)))
  ps
  (hypT mpg.2  gen mpg.1 ax-mp))
thm (mpgbi ((T x))
  ((mpgbi.1 (<-> (A. x T ph) ps))
   (mpgbi.2 (-> (: (cv x) T) ph))
   (hypT (istype T)))
  ps
  (mpgbi.1 biimp mpgbi.2 hypT mpg))
thm (mpgbir ((T x))
  ((mpgbir.1 (<-> ph (A. x T ps)))
   (mpgbir.2 (-> (: (cv x) T) ps))
   (hypT (istype T)))
  ph
  (mpgbir.1 biimpr mpgbir.2 hypT mpg))

thm (19.20i ((T x))
  ((hyp1 (istype T))
   (hyp2 (-> (: (cv x) T) (-> ph ps))))
  (-> (A. x T ph) (A. x T ps))
  (hyp1 hyp2 gen hyp1 x ph ps alim ax-mp))

thm (19.20ii ((T x))
  ((hyp (-> (/\ (: (cv x) T) ph) (-> ps ch)))
   (hypT (istype T)))
  (-> (A. x T ph) (-> (A. x T ps) (A. x T ch)))
  (
   hypT hyp exp 19.20i
   hypT x ps ch alim syl
))

thm (19.20i2 ((T x) (T y))
  ((hyp (-> ph ps))
   (hypT (istype T)))
  (-> (A. x T (A. y T ph)) (A. x T (A. y T ps)))
  (
