thm (19.35 ((T x))
  ((hyp (istype T)))
  (<-> (E. x T (-> ph ps)) (-> (A. x T ph) (E. x T ps)))
  (hyp x ph (-. ps) 19.26
   ph ps annim hyp x albii
   (A. x T ph) (A. x T (-. ps)) df-an 3bitr3
   bicon2i
   x T ps df-ex (A. x T ph) imbi2i
   x T (-> ph ps) df-ex 3bitr4r
))

thm (alphalem1 ((T x y))
  ((hyp (istype T)))
  (-> (A. x T (A. y T (-> (= T (cv x) (cv y)) (<-> (A. y T ph) (A. x T ps)))))
      (-> (A. x T (A. y T ph)) (A. y T (A. x T ps))))
  (


     hyp x (A. y T ph) spec-var
     (A. y T ph) (A. x T ps) ibib pm5.74ri biimprd syl6
     imp (= T (cv x) (cv y)) imim2d

     hyp
     hyp x (A. y T ph) nfi_bound
   19.21ai

     hyp x
     (-> (= T (cv x) (cv y)) (<-> (A. y T ph) (A. x T ps)))
     (-> (= T (cv x) (cv y)) (A. x T ps))
   alim syl

     hyp x
     (= T (cv x) (cv y))
     (A. x T ps)
   19.22 syl6

     (cv y) T x df-ty
     hyp x ps nfi_bound hyp nfii_ex
   imbi12i syl6ibr com23 imp

     hyp
     hyp y ph nfi_bound hyp hyp x nfi_al
   19.21ai

     hyp y
     (A. x T (-> (= T (cv x) (cv y)) (<-> (A. y T ph) (A. x T ps))))
     (A. x T ps)
   alim
     hyp hyp x y (-> (= T (cv x) (cv y)) (<-> (A. y T ph) (A. x T ps))) alcom
     (A. y T (A. x T ps))
   imbi1i sylibr syl com12
))

thm (alphalem2 ((T x y))
  ((hyp (istype T)))
  (-> (A. x T (A. y T (-> (= T (cv x) (cv y)) (<-> (A. y T ph) (A. x T ps)))))
      (<-> (A. x T (A. y T ph)) (A. y T (A. x T ps))))
  (hyp x y ph ps alphalem1

     hyp (cv y) (cv x) eqcom
     (A. x T ps) (A. y T ph) bicom
     imbi12i
     hyp x albii hyp y albii
   hyp hyp y x (-> (= T (cv x) (cv y)) (<-> (A. y T ph) (A. x T ps))) alcom bitr
   hyp y x ps ph alphalem1
   sylbir impbid
))

thm (alphat ((T x y))
  ((hyp1 (istype T))
   (hyp2 (nfi y T ph))
   (hyp3 (nfi x T ps)))
  (-> (A. x T (A. y T (-> (= T (cv x) (cv y)) (<-> ph ps))))
      (<-> (A. x T ph) (A. y T ps)))
  (hyp1 x y ph ps alphalem2

   hyp2 nfii hyp3 nfii bibi12i (= T (cv x) (cv y)) imbi2i
   hyp1 y albii hyp1 x albii

     hyp2 nfii hyp1 x albii
     hyp3 nfii hyp1 y albii
   bibi12i imbi12i mpbir
))

thm (cbval ((T x y))
  ((hyp2 (nfi y T ph))
   (hyp3 (nfi x T ps))
   (hyp4 (-> (/\ (: (cv x) T) (: (cv y) T))
     (-> (= T (cv x) (cv y)) (<-> ph ps))))
   (hypT (istype T)))
  (<-> (A. x T ph) (A. y T ps))
  (hypT hypT hyp4 expcom gen
   hypT hypT y (: (cv x) T) nfi_dv (-> (= T (cv x) (cv y)) (<-> ph ps)) 19.21 mpbi gen
   hypT hyp2 hyp3 alphat ax-mp)
)

thm (cbvalv ((T x y) (ph y) (ps x))
  ((hyp4 (-> (/\ (: (cv x) T) (: (cv y) T))
     (-> (= T (cv x) (cv y)) (<-> ph ps))))
   (hypT (istype T)))
  (<-> (A. x T ph) (A. y T ps))
  (hypT y ph nfi_dv hypT x ps nfi_dv hyp4 hypT cbval)
)

