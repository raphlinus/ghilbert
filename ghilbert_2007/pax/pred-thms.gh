   hyp
     hyp hyp (cv y) x ph sbceq1 gen
       hyp ph ps ([:=] x T (cv y) ph) bibi1 (= T (cv x) (cv y)) imbi2d y bialdv
     mpbii
   (: (cv x) T) a1i 19.20i
