))

thm (19.21 ((T x))
  ((hyp1 (istype T))
   (hyp2 (nfi x T ph)))
  (<-> (A. x T (-> ph ps)) (-> ph (A. x T ps)))
  (
   hyp1 x ph ps alim hyp2 nfii syl5ib
     hyp2
     hyp1 x ps nfi_bound
   hyp1 nfi_im nfii
     hyp1
     hyp1 x ps spec-var com12
     ph imim2d
   19.20i

   sylbi impbi
))

thm (19.21v ((T x) (ph x))
  ((hyp1 (istype T)))
  (<-> (A. x T (-> ph ps)) (-> ph (A. x T ps)))
  (hyp1 hyp1 x ph nfi_dv ps 19.21))

thm (19.21ai ((T x))
  ((hyp1 (-> (/\ ph (: (cv x) T)) ps))
   (hyp2 (istype T))
   (hyp3 (nfi x T ph)))
  (-> ph (A. x T ps))
  ( hyp2 hyp1 ancoms exp gen
      hyp2 x ph ps alim
      hyp3 x T ph df-nfi mpbi (A. x T ps) imbi1i sylibr
    ax-mp
))

thm (19.21aiv ((T x) (ph x))
  ((hyp1 (-> (/\ ph (: (cv x) T)) ps))
   (hypT (istype T)))
  (-> ph (A. x T ps))
