# Pure equality thms

thm (eqid ((T x) (A x))
  ((hyp1 (istype T)))
  (-> (: A T) (= T A A))
  (  A T x df-ty

     hyp1
       hyp1 (cv x) A eqcom
     biimp ancri
     hyp1 A (cv x) A ax-eqtr syl
     (: (cv x) T) a1i 19.22i
   sylbi

   hyp1 x (= T A A) nfi_dv hyp1 nfii_ex
   sylibr
))

thm (eqeq1 () ((hyp (istype T)))
  (-> (= T A B) (<-> (= T A C) (= T B C)))
  (    hyp C A B ax-eqtr ancoms exp
       hyp C A eqcom hyp C B eqcom imbi12i
     sylib
   hyp A B C ax-eqtr exp
   impbid
))

thm (eqcoms ()
  ((hyp (-> (= T A B) ph))
   (hypT (istype T)))
  (-> (= T B A) ph)
  (hypT B A eqcom hyp sylbi
))

thm (eqeq2 () ((hyp (istype T)))
  (-> (= T A B) (<-> (= T C A) (= T C B)))
  (  hyp A B C eqeq1
     hyp A C eqcom hyp B C eqcom bibi12i
   sylib
))

