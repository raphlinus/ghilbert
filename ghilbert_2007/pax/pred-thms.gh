     iota-alphaconvt
   syl
     hyp y ph nfi_dv
       hyp x (cv y) ph nfi_sbc
         hyp (cv y) x ph sbceq1 (: (cv x) T) adantl
     hyp iota-alphaconv
   hyp syl6reqr
))

# problematic (depends on iota-alphaconvt)
