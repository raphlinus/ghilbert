))

thm (19.26 ((T x))
  ((hyp (istype T)))
  (<-> (A. x T (/\ ph ps)) (/\ (A. x T ph) (A. x T ps)))
  (
   hyp ph ps pm3.26 (: (cv x) T) a1i gen hyp x (/\ ph ps) ph alim ax-mp
   hyp ph ps pm3.27 (: (cv x) T) a1i gen hyp x (/\ ph ps) ps alim ax-mp jca

     hyp x ph spec-var com12
     hyp x ps spec-var com12 anim12d com12 imp
       hyp
         hyp x ph nfi_bound hyp x ps nfi_bound hyp nfi_an
     19.21ai
   impbi
))

thm (margaris17.10 ((T x y) (T' x y))
  ((hyp1 (istype T))
   (hyp2 (istype T')))
  (-> (A. x T (A. y T' ph)) (A. y T' (A. x T ph)))
  (

   hyp1 x (A. y T' ph) spec-var imp
   hyp2 y ph spec-var syl exp com23 imp31
     hyp1
       hyp1 x (A. y T' ph) nfi_bound
         hyp1 x (: (cv y) T') nfi_dv
     hyp1 nfi_an
   19.21ai

     hyp2
       hyp2 y ph nfi_bound hyp2 hyp1 x nfi_al
   19.21ai
))

# aka 19.5
thm (alcom ((T x y) (T' x y))
  ((hyp1 (istype T))
   (hyp2 (istype T')))
  (<-> (A. x T (A. y T' ph)) (A. y T' (A. x T ph)))
  (  hyp1 hyp2 x y ph margaris17.10
     hyp2 hyp1 y x ph margaris17.10
   impbi
))

