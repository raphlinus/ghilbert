   (hyp2 (nfi x T ps))
   (hypT (istype T)))
  (<-> (A. x T (A. y T (/\ ph ps))) (/\ (A. x T ph) (A. y T ps)))
  (
   hyp1 hypT ps 19.28
   hypT x albii
     hyp2 hypT hypT y nfi_al hypT ph 19.27
   bitr
))

