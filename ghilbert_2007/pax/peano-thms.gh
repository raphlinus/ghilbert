))

# This would go a bit easier if we had a vtocleg2 for N. Alternatively,
# sbctru and mksbcN would provide a similar proof path.
thm (pa_ax6r ((A x y) (B x)) ()
  (-> (/\ (: A (N.T)) (: B (N.T)))
    (= (N.T) (* (S A) B) (+ (* A B) B)))
  (
   (cv x) B df-=N biimpr (: (cv x) (N.T)) anim2i arll-l alarl

     A eqNid pa-ax2cd pa-ax5cd
       A eqNid pa-ax5cd pa-ax3cd
     eqNtr4d
       0:N
         (=N (cv x) (0)) id (S A) muleq2cd
         A S:N sylan2
           (=N (cv x) (0)) id A muleq2cd
             (=N (cv x) (0)) id
         addeq12ca allar
         eqeqN12d exp pm5.74d
       mksbcN ax-mp
     mpbir

       A eqNid pa-ax2cd (cv x) eqNid pa-ax6ca
         (=N (* (S A) (cv x)) (+ (* A (cv x)) (cv x))) id
         A eqNid pa-ax2cd addeq12ca
       eqNtra arr-l al-rl allarl
         A (cv x) *:N (: (cv x) (N.T)) id A S:N addassNa alr-l al-rr alar
       eqNtra allar
         A eqNid (cv x) eqNid muleq12ca
           (: (cv x) (N.T)) id (: A (N.T)) id pa-ax4Na
           (: (cv x) (N.T)) id (: A (N.T)) id addcomNa pa-ax2cd eqNtrd al-r
           (: A (N.T)) id (: (cv x) (N.T)) id pa-ax4Na eqNtr4d
         addeq12cd
       eqNtra allar
         A (cv x) *:N (: A (N.T)) id (cv x) S:N addassNa ar-l al-rr alar
       eqNtr4a allar
         A eqNid (cv x) eqNid pa-ax6ca
         (cv x) eqNid pa-ax2cd addeq12ca alrar
       eqNtr4a allar
       exp31 com12 a2d

         (cv x) S:N
             (=N (cv x) (cv y)) id (S A) muleq2cd
           A S:N sylan2
             (=N (cv x) (cv y)) id A muleq2cd
             (=N (cv x) (cv y)) id
           addeq12ca allar
         eqeqN12d exp pm5.74d
             (=N (cv y) (S (cv x))) id (S A) muleq2cd
           A S:N sylan2
             (=N (cv y) (S (cv x))) id A muleq2cd
             (=N (cv y) (S (cv x))) id
           addeq12ca allar
         eqeqN12d exp pm5.74d
         mksbcN2 syl
       sylibrd
     findes
     imp

       A S:N (=N (cv x) B) id (S A) muleq2cd syl-r
         (=N (cv x) B) id A muleq2cd
         (=N (cv x) B) id addeq12ca allar
       eqeqN12d biimpd com12
     syl imp alrarr alr-r exp

   syl al-ll exp
   N.istype vtocleg2 imp al-r
   df-=Nad pm3.27d
))

