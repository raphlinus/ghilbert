var (wff ph ps ch th ta)
var (type T) # only used for a few thms like alpha-exd
var (val A B C D A' B' C')
var (var x y z x' y')

thm (addeq1 () ()
  (-> (/\ (/\ (: A (N.T)) (: B (N.T))) (: C (N.T)))
    (-> (= (N.T) A B) (= (N.T) (+ A C) (+ B C))))
  (N.istype C eqid (/\ (: A (N.T)) (: B (N.T))) adantl
       (: C (N.T)) anidm (/\ (: A (N.T)) (: B (N.T))) anbi2i
       A B C C addeq12
     sylbir
   exp3a com23 mpd
))
# in new set.mm, the last three steps are mpan2d

thm (addeq2 () ()
  (-> (/\ (/\ (: A (N.T)) (: B (N.T))) (: C (N.T)))
    (-> (= (N.T) A B) (= (N.T) (+ C A) (+ C B))))
  (N.istype C eqid (/\ (: A (N.T)) (: B (N.T))) adantr
       (: C (N.T)) anidm (/\ (: A (N.T)) (: B (N.T))) anbi1i
       C C A B addeq12
     sylbir
   exp3a mpd ancoms
))

thm (muleq1 () ()
  (-> (/\ (/\ (: A (N.T)) (: B (N.T))) (: C (N.T)))
    (-> (= (N.T) A B) (= (N.T) (* A C) (* B C))))
  (N.istype C eqid (/\ (: A (N.T)) (: B (N.T))) adantl
       (: C (N.T)) anidm (/\ (: A (N.T)) (: B (N.T))) anbi2i
       A B C C muleq12
     sylbir
   exp3a com23 mpd
))
# in new set.mm, the last three steps are mpan2d

thm (muleq2 () ()
  (-> (/\ (/\ (: A (N.T)) (: B (N.T))) (: C (N.T)))
    (-> (= (N.T) A B) (= (N.T) (* C A) (* C B))))
  (N.istype C eqid (/\ (: A (N.T)) (: B (N.T))) adantr
       (: C (N.T)) anidm (/\ (: A (N.T)) (: B (N.T))) anbi1i
       C C A B muleq12
     sylbir
   exp3a mpd ancoms
))

thm (findes ((x y z) (ph y z))
  ((hyp1 ([:=] x (N.T) (0) ph))
   (hyp2 (-> (: (cv x) (N.T)) (-> ph ([:=] x (N.T) (S (cv x)) ph)))))
  (-> (: (cv x) (N.T)) ph)
  (
    hyp1
   0:N N.istype (0) x ph sbc6 ax-mp mpbi

     N.istype
       N.istype hyp2 (cv y) sbctru
       N.istype (cv y) x ph ([:=] x (N.T) (S (cv x)) ph) sbcim
     mpbid
       N.istype (cv y) x ph sbc6
         N.istype (cv x) (cv y) pa_ax2 biimpd ph sbcco3
           (cv y) S:N
           N.istype (S (cv y)) x ph sbc6
         syl
       bitrd
     imbi12d
     mpbid
   gen

   x ph y ind
   mp2an

   N.istype x ph spec-var ax-mp
))

thm (pa_ax2d ()
  ((hyp (-> ph (/\ (: A (N.T)) (: B (N.T))))))
  (-> ph (<-> (= (N.T) A B) (= (N.T) (S A) (S B))))
  (hyp A B pa_ax2 syl
))

thm (pa_ax3d ()
  ((hyp (-> ph (: A (N.T)))))
  (-> ph (= (N.T) (+ A (0)) A))
  (hyp A pa_ax3 syl))

thm (pa_ax4d ()
  ((hyp (-> ph (/\ (: A (N.T)) (: B (N.T))))))
  (-> ph (= (N.T) (+ A (S B)) (S (+ A B))))
  (hyp A B pa_ax4 syl
))

thm (pa_ax3r ((x y) (A x)) () (-> (: A (N.T))
  (= (N.T) (+ (0) A) A))
  (
   0:N (0) pa_ax3 ax-mp
   0:N
     N.istype
       N.istype
       0:N (cv x) (0) (0) addeq2 exp31 pm2.43d mpi imp
       (= (N.T) (cv x) (0)) id (: (cv x) (N.T)) adantl
     eqeq12d exp (: (0) (N.T)) adantr mksbc2
     # [x := 0] 0 + x = x <-> 0 + 0 = 0
   ax-mp mpbir

     0:N (0) (cv x) pa_ax4 mpan (= (N.T) (+ (0) (cv x)) (cv x)) adantr
       0:N (0) (cv x) +:N mpan
     (+ (0) (cv x)) (cv x) pa_ax2 exp syl pm2.43i biimpd imp
   N.istype eqtrd
     (cv x) S:N
       N.istype
         N.istype
         0:N (cv x) (cv y) (0) addeq2 mpan2 imp
         (= (N.T) (cv x) (cv y)) id (/\ (: (cv x) (N.T)) (: (cv y) (N.T))) adantl
       eqeq12d exp
         N.istype
         0:N (cv y) (S (cv x)) (0) addeq2 mpan2 imp
         (= (N.T) (cv y) (S (cv x))) id (/\ (: (cv y) (N.T)) (: (S (cv x)) (N.T))) adantl
       eqeq12d exp
     mksbc3 syl  (= (N.T) (+ (0) (cv x)) (cv x)) adantr
     # [x := S(x)] 0 + x = x <-> 0 + S(x) = S(x)
   mpbird exp
   findes

   (: A (N.T)) adantr (= (N.T) (cv x) A) adantr
     N.istype
     0:N (cv x) A (0) addeq2 mpan2 imp
     (= (N.T) (cv x) A) id (/\ (: (cv x) (N.T)) (: A (N.T))) a1i imp
   eqeq12d mpbid exp
   N.istype vtocleg2
))

thm (S:Nd ()
  ((hyp (-> ph (: A (N.T)))))
  (-> ph (: (S A) (N.T)))
  (hyp A S:N syl))

thm (+:Nd ()
  ((hyp (-> ph (/\ (: A (N.T)) (: B (N.T))))))
  (-> ph (: (+ A B) (N.T)))
  (hyp A B +:N syl))

thm (*:Nd ()
  ((hyp (-> ph (/\ (: A (N.T)) (: B (N.T))))))
  (-> ph (: (* A B) (N.T)))
  (hyp A B *:N syl))

# [x:=0] (S(A) + x = S(A + x) <-> S(A) + 0 = S(A + 0)
# invariant: S(A) + x = S(A + x)
thm (pa_ax4r ((A x y) (B x)) ()
  (-> (/\ (: A (N.T)) (: B (N.T)))
    (= (N.T) (+ (S A) B) (S (+ A B))))
  (

       A S:N (S A) pa_ax3 syl A pa_ax3
       0:N A (0) +:N mpan2 ancri pa_ax2d mpbid
     N.istype eqtr4d

     0:N
     N.istype N.istype
     0:N (cv x) (0) (S A) addeq2 mpanl2
     A S:N sylan2 imp
       0:N (cv x) (0) A addeq2 mpanl2
     A (cv x) +:N 0:N A (0) +:N mpan2 anim12i anabss1 pa_ax2d ancoms sylibd imp
     eqeq12d an1rs exp pm5.74d exp (: (0) (N.T)) adantr
     mksbc2 ax-mp
   mpbir

     A S:N (: (cv x) (N.T)) anim1i pa_ax4d ancoms
       A S:N (: (cv x) (N.T)) anim1i +:Nd ancoms
     A (cv x) +:N ancoms S:Nd jca pa_ax2d biimpd imp
   N.istype eqtra anabss5
       A (cv x) pa_ax4 ancoms
     (cv x) S:N (: A (N.T)) anim2i +:Nd A (cv x) +:N S:Nd jca ancoms pa_ax2d mpbid
   N.istype eqtr4a anabss1 exp31 a2d

     (cv x) S:N
        N.istype
          N.istype
          (cv x) (cv y) (S A) addeq2
          A S:N sylan2 imp

            (cv x) (cv y) A addeq2
          A (cv x) +:N A (cv y) +:N anim12i 3impdi 3coml 3expa pa_ax2d sylibd imp
       eqeq12d an1rs exp pm5.74d exp
          N.istype
          (cv y) (S (cv x)) (S A) addeq2
          A S:N sylan2 imp

            (cv y) (S (cv x)) A addeq2
          A (cv y) +:N A (S (cv x)) +:N anim12i 3impdi 3coml 3expa pa_ax2d sylibd imp
       eqeq12d an1rs exp pm5.74d exp
     mksbc3 syl
   sylibrd
   findes (: B (N.T)) adantr imp (= (N.T) (cv x) B) adantr

     N.istype
     (cv x) B (S A) addeq2 exp A S:N syl5 imp31

       (cv x) B A addeq2

         A (cv x) +:N
         A B +:N
       anim12i 3impdi 3coml 3expa pa_ax2d biimpd

     syld imp
   eqeq12d mpbid exp31 com23 N.istype vtocleg2 impcom
))

# invariant: x + B = B + x
thm (addcom ((B x y) (A x)) () (-> (/\ (: A (N.T)) (: B (N.T)))
  (= (N.T) (+ A B) (+ B A)))
  (

   B pa_ax3r B pa_ax3 N.istype eqtr4d

   0:N N.istype
     N.istype
     0:N (cv x) (0) B addeq1 an1rs mpan2 imp
     0:N (cv x) (0) B addeq2 an1rs mpan2 imp
   eqeq12d an1rs exp pm5.74d exp
   (: (0) (N.T)) adantr mksbc2 ax-mp
   mpbir

     (cv x) B pa_ax4r

     B (cv x) pa_ax4 ancoms (= (N.T) (+ (cv x) B) (+ B (cv x))) adantr

       (+ (cv x) B) (+ B (cv x)) pa_ax2
       (cv x) B +:N B (cv x) +:N ancoms
     sylanc biimpd imp N.istype eqtr4d

   N.istype eqtr4a anabss5 exp31 a2d

   (cv x) S:N
     N.istype
       N.istype
       (cv x) (cv y) B addeq1 imp
       (cv x) (cv y) B addeq2 imp
     eqeq12d exp31 com23 imp pm5.74d exp
       N.istype
       (cv y) (S (cv x)) B addeq1 imp
       (cv y) (S (cv x)) B addeq2 imp
     eqeq12d exp31 com23 imp pm5.74d exp
   mksbc3 syl
   sylibrd findes (: A (N.T)) adantr imp (= (N.T) (cv x) A) adantr

     N.istype
     (cv x) A B addeq1 imp
     (cv x) A B addeq2 imp
   eqeq12d mpbid exp31 com23 N.istype vtocleg2 imp
))

thm (pa_ax4rd ()
  ((hyp (-> ph (/\ (: A (N.T)) (: B (N.T))))))
  (-> ph (= (N.T) (+ (S A) B) (S (+ A B))))
  (hyp A B pa_ax4r syl
))

thm (addeq1d ()
  ((hyp (-> ph (/\ (/\ (: A (N.T)) (: B (N.T))) (: C (N.T))))))
  (-> ph (-> (= (N.T) A B) (= (N.T) (+ A C) (+ B C))))
  (hyp A B C addeq1 syl))

thm (addeq2d ()
  ((hyp (-> ph (/\ (/\ (: A (N.T)) (: B (N.T))) (: C (N.T))))))
  (-> ph (-> (= (N.T) A B) (= (N.T) (+ C A) (+ C B))))
  (hyp A B C addeq2 syl))

thm (muleq1d ()
  ((hyp (-> ph (/\ (/\ (: A (N.T)) (: B (N.T))) (: C (N.T))))))
  (-> ph (-> (= (N.T) A B) (= (N.T) (* A C) (* B C))))
  (hyp A B C muleq1 syl))

thm (muleq2d ()
  ((hyp (-> ph (/\ (/\ (: A (N.T)) (: B (N.T))) (: C (N.T))))))
  (-> ph (-> (= (N.T) A B) (= (N.T) (* C A) (* C B))))
  (hyp A B C muleq2 syl))

# invariant (x + B) + C = x + (B + C)
thm (addass ((A x) (B x y) (C x y)) ()
  (-> (/\ (/\ (: A (N.T)) (: B (N.T))) (: C (N.T)))
    (= (N.T) (+ (+ A B) C) (+ A (+ B C))))
  (

     B pa_ax3r (: C (N.T)) adantr
     0:N (: B (N.T)) jctl +:Nd ancri  (: C (N.T)) anim1i addeq1d mpd
     B C +:N (+ B C) pa_ax3r syl
   N.istype eqtr4d

   0:N
     N.istype
       N.istype
         (cv x) (0) B addeq1 (: C (N.T)) adantr
       (cv x) B +:N (0) B +:N anim12i alrarr alr-r (: C (N.T)) anim1i addeq1d syld
       ar-l al-rr imp

       B C +:N (/\ (: (cv x) (N.T)) (: (0) (N.T))) anim2i addeq1d imp
     eqeq12d alr-r exp pm5.74d exp
   mksbc2 ax-mp
   mpbir

       (cv x) B pa_ax4r (: C (N.T)) adantr
     (cv x) S:N (: B (N.T)) anim1i +:Nd (cv x) B +:N S:Nd jca (: C (N.T)) anim1i addeq1d mpd
     (cv x) B +:N (: C (N.T)) anim1i pa_ax4rd
   N.istype eqtrd
       (cv x) B +:N (: C (N.T)) anim1i +:Nd
       B C +:N (: (cv x) (N.T)) anim2i +:Nd al-ll
     jca pa_ax2d biimpd imp
   N.istype eqtra alarl
     B C +:N (: (cv x) (N.T)) anim2i pa_ax4rd al-ll
   N.istype eqtr4a allar allr-l al-lrl exp31 a2d

   (cv x) S:N
     N.istype
       N.istype
         (cv x) (cv y) B addeq1 (: C (N.T)) adantr
       (cv x) B +:N (cv y) B +:N anim12i alrarr alr-r (: C (N.T)) anim1i addeq1d syld
       ar-l al-rr imp

       B C +:N (/\ (: (cv x) (N.T)) (: (cv y) (N.T))) anim2i addeq1d imp
     eqeq12d alr-r exp pm5.74d exp
       N.istype
         (cv y) (S (cv x)) B addeq1 (: C (N.T)) adantr
       (cv y) B +:N (S (cv x)) B +:N anim12i alrarr alr-r (: C (N.T)) anim1i addeq1d syld
       ar-l al-rr imp

       B C +:N (/\ (: (cv y) (N.T)) (: (S (cv x)) (N.T))) anim2i addeq1d imp
     eqeq12d alr-r exp pm5.74d exp
   mksbc3 syl

   sylibrd

   findes

     N.istype
       (cv x) A B addeq1 alr-r (: C (N.T)) adantr
       (cv x) B +:N A B +:N anim12i alrarr (: C (N.T)) anim1i addeq1d syld
     ar-l al-lrr all-l al-rl imp
     B C +:N (cv x) A (+ B C) addeq1 ar-l exp syl imp31
   eqeq12d all-r exp pm5.74d biimpa
   syl-r alll-l arr-l alarl al-ll exp N.istype vtocleg2 imp al-ll
))

thm (pa_ax5r ((A x) (x y)) ()
  (-> (: A (N.T)) (= (N.T) (* (0) A) (0)))
  (
   N.istype 0:N (cv x) A (0) muleq2 mpan2 imp (0) eqeq1d

   0:N (0) pa_ax5 ax-mp

   0:N
     N.istype
     N.istype 0:N (cv x) (0) (0) muleq2 mpan2 imp (0) eqeq1d exp
   mksbc2 ax-mp mpbir

   (cv x) S:N
     N.istype
     N.istype 0:N (cv x) (cv y) (0) muleq2 mpan2 imp (0) eqeq1d exp
     N.istype 0:N (cv y) (S (cv x)) (0) muleq2 mpan2 imp (0) eqeq1d exp
   mksbc3 syl

     N.istype
     0:N (0) (cv x) pa_ax6 mpan
     0:N (0) (cv x) *:N pa_ax3d mpan
   N.istype eqtrd (0) eqeq1d bitrd biimprd
   findes

   syl5bi anasss com12 anabsi5 anassrs exp
   N.istype vtocleg2
))


# Some cool definitions

def ((=N A B) (/\ (/\ (: A (N.T)) (: B (N.T))) (= (N.T) A B)))

thm (df-=N () ()
  (<-> (=N A B) (/\ (/\ (: A (N.T)) (: B (N.T))) (= (N.T) A B)))
  ((/\ (/\ (: A (N.T)) (: B (N.T))) (= (N.T) A B)) pm4.2))

thm (df-=Nad ()
  ((hyp (-> ph (=N A B))))
  (-> ph (/\ (/\ (: A (N.T)) (: B (N.T))) (= (N.T) A B)))
  (hyp A B df-=N sylib))

thm (df-=Nbd ()
  ((hyp (-> ph (/\ (/\ (: A (N.T)) (: B (N.T))) (= (N.T) A B)))))
  (-> ph (=N A B))
  (hyp A B df-=N sylibr))

thm (eqNid () ()
  (-> (: A (N.T)) (=N A A))
  (  (: A (N.T)) id ancli
     N.istype A eqid
   jca df-=Nbd
))

thm (eqNtrt () ()
  (-> (/\ (=N A B) (=N B C)) (=N A C))
  (
     A B df-=N biimp pm3.26d pm3.26d
     B C df-=N biimp pm3.26d pm3.27d
   anim12i
     A B df-=N biimp pm3.27d
     B C df-=N biimp pm3.27d
   anim12i N.istype A B C ax-eqtr syl
   jca df-=Nbd
))

thm (eqNcomd ()
  ((hyp (-> ph (=N A B))))
  (-> ph (=N B A))
  (
   hyp df-=Nad pm3.26d pm3.27d
     hyp df-=Nad pm3.26d pm3.26d
   jca
     N.istype
       hyp df-=Nad pm3.27d
     eqcomd
   jca df-=Nbd
))

thm (eqNcom () ()
  (<-> (=N A B) (=N B A))
  ((=N A B) id eqNcomd (=N B A ) id eqNcomd impbi
))

thm (eqNcomi ()
  ((hyp (=N A B)))
  (=N B A)
  (hyp A B eqNcom mpbi))

thm (eqNtrd ()
  ((hyp1 (-> ph (=N A B)))
   (hyp2 (-> ph (=N B C))))
  (-> ph (=N A C))
  (hyp1 hyp2 jca A B C eqNtrt syl))

thm (eqNtra ()
  ((hyp1 (-> ph (=N A B)))
   (hyp2 (-> ps (=N B C))))
  (-> (/\ ph ps) (=N A C))
  (hyp1 ps adantr hyp2 ph adantl eqNtrd))

thm (eqNtr3d ()
  ((hyp1 (-> ph (=N A B)))
   (hyp2 (-> ph (=N A C))))
  (-> ph (=N B C))
  (hyp1 eqNcomd hyp2 eqNtrd))

thm (eqNtr3a ()
  ((hyp1 (-> ph (=N A B)))
   (hyp2 (-> ps (=N A C))))
  (-> (/\ ph ps) (=N B C))
  (hyp1 ps adantr hyp2 ph adantl eqNtr3d))

thm (eqNtr4 ()
  ((hyp1 (=N A B))
   (hyp2 (=N C B)))
  (=N A C)
  (hyp1 hyp2 eqNcomi A B C eqNtrt mp2an))

thm (eqNtr4d ()
  ((hyp1 (-> ph (=N A B)))
   (hyp2 (-> ph (=N C B))))
  (-> ph (=N A C))
  (hyp1 hyp2 eqNcomd eqNtrd))

thm (eqNtr4a ()
  ((hyp1 (-> ph (=N A B)))
   (hyp2 (-> ps (=N C B))))
  (-> (/\ ph ps) (=N A C))
  (hyp1 ps adantr hyp2 ph adantl eqNtr4d))

thm (eqeqN12d ()
  ((hyp1 (-> ph (=N A A')))
   (hyp2 (-> ph (=N B B'))))
  (-> ph (<-> (=N A B) (=N A' B')))
  (

   N.istype hyp1 df-=Nad pm3.27d hyp2 df-=Nad pm3.27d eqeq12d

   hyp1 df-=Nad pm3.26d pm3.26d hyp2 df-=Nad pm3.26d pm3.26d jca
   (/\ (: A (N.T)) (: B (N.T))) (= (N.T) A B) ibar syl
   A B df-=N syl6bbr

   hyp1 df-=Nad pm3.26d pm3.27d hyp2 df-=Nad pm3.26d pm3.27d jca
   (/\ (: A' (N.T)) (: B' (N.T))) (= (N.T) A' B') ibar syl
   A' B' df-=N syl6bbr

   3bitr3d
))

thm (eqeqN1d ()
  ((hyp (-> ph (=N A B))))
  (-> ph (<-> (=N A C) (=N B C)))
  (
   hyp (: C (N.T)) adantl C eqNid ph adantr eqeqN12d exp
     A C df-=N biimp pm3.26d pm3.27d
       B C df-=N biimp pm3.26d pm3.27d
     pm5.21ni ph a1d
   pm2.61i
))

thm (eqeqN2d ()
  ((hyp (-> ph (=N A B))))
  (-> ph (<-> (=N C A) (=N C B)))
  (
   hyp C eqeqN1d
     A C eqNcom
       B C eqNcom
     bibi12i
   sylib
))

thm (eqeqN12a ()
  ((hyp1 (-> ph (=N A A')))
   (hyp2 (-> ps (=N B B'))))
  (-> (/\ ph ps) (<-> (=N A B) (=N A' B')))
  (hyp1 ps adantr hyp2 ph adantl eqeqN12d
))

thm (addeq1cd ()
  ((hyp (-> ph (=N A B))))
  (-> (/\ ph (: C (N.T))) (=N (+ A C) (+ B C)))
  (
     hyp df-=Nad pm3.26d pm3.26d (: C (N.T)) anim1i +:Nd
     hyp df-=Nad pm3.26d pm3.27d (: C (N.T)) anim1i +:Nd
   jca
     hyp df-=Nad pm3.26d (: C (N.T)) anim1i addeq1d
     hyp df-=Nad pm3.27d
   syl5 imp allar
   jca df-=Nbd
))

thm (addeq2cd ()
  ((hyp (-> ph (=N A B))))
  (-> (/\ ph (: C (N.T))) (=N (+ C A) (+ C B)))
  (
     hyp df-=Nad pm3.26d pm3.26d (: C (N.T)) anim2i +:Nd
     hyp df-=Nad pm3.26d pm3.27d (: C (N.T)) anim2i +:Nd
   jca al-r
     hyp df-=Nad pm3.26d (: C (N.T)) anim1i addeq2d
     hyp df-=Nad pm3.27d
   syl5 imp allar
   jca df-=Nbd
))

thm (addeq12cd ()
  ((hyp1 (-> ph (=N A A')))
   (hyp2 (-> ph (=N B B'))))
  (-> ph (=N (+ A B) (+ A' B')))
  (
     hyp2 df-=Nad pm3.26d pm3.26d
   hyp1 B addeq1cd mpdan
     hyp1 df-=Nad pm3.26d pm3.27d
   hyp2 A' addeq2cd mpdan
   eqNtrd
))

thm (addeq12ca ()
  ((hyp1 (-> ph (=N A A')))
   (hyp2 (-> ps (=N B B'))))
  (-> (/\ ph ps) (=N (+ A B) (+ A' B')))
  (hyp1 ps adantr hyp2 ph adantl addeq12cd))

thm (muleq1cd ()
  ((hyp (-> ph (=N A B))))
  (-> (/\ ph (: C (N.T))) (=N (* A C) (* B C)))
  (
     hyp df-=Nad pm3.26d pm3.26d (: C (N.T)) anim1i *:Nd
     hyp df-=Nad pm3.26d pm3.27d (: C (N.T)) anim1i *:Nd
   jca
     hyp df-=Nad pm3.26d (: C (N.T)) anim1i muleq1d
     hyp df-=Nad pm3.27d
