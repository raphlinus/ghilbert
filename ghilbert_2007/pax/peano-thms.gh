# invariant (x * B) * C = x * (B * C)
thm (mulass ((A x) (B x y) (C x y)) ()
  (-> (/\ (/\ (: A (N.T)) (: B (N.T))) (: C (N.T)))
    (= (N.T) (* (* A B) C) (* A (* B C))))
