# Induction with implicit substitution, using =N for equality
thm (findsN ((x y) (A x) (ps x) (ch x) (th x) (ta x) (ph y))
  ((hyp1 (-> (=N (cv x) (0)) (<-> ph ps)))
   (hyp2 (-> (=N (cv x) (cv y)) (<-> ph ch)))
   (hyp3 (-> (=N (cv x) (S (cv y))) (<-> ph th)))
   (hyp4 (-> (=N (cv x) A) (<-> ph ta)))
   (hyp5 ps)
   (hyp6 (-> (: (cv y) (N.T)) (-> ch th))))
  (-> (: A (N.T)) ta)
  (
   N.istype
     hyp5
       0:N (=N (cv y) (cv x)) id eqNcomd hyp2 syl bicomd hyp1 mksbcN2 ax-mp
     mpbir
       hyp6
         (cv y) S:N (=N (cv y) (cv x)) id eqNcomd hyp2 syl bicomd hyp3 mksbcN2 syl
       sylibrd
     findes
   A sbctru   
     (=N (cv y) (cv x)) id eqNcomd hyp2 syl bicomd hyp4 mksbcN2
   mpbid
))

# ind hyp: B+x = C+x <-> B+C
thm (addcan () ()
  (-> (/\ (: A (N.T)) (/\ (: B (N.T)) (: C (N.T))))
   (<-> (=N (+ B A) (+ C A)) (=N B C)))
  (
   (=N (cv x) (0)) id B addeq2cd
     (=N (cv x) (0)) id C addeq2cd
   eqeqN12a allarl all-l (=N B C) bibi1d exp pm5.74d
     (=N (cv x) (cv y)) id B addeq2cd
       (=N (cv x) (cv y)) id C addeq2cd
     eqeqN12a allarl all-l  (=N B C) bibi1d exp pm5.74d
       (=N (cv x) (S (cv y))) id B addeq2cd
         (=N (cv x) (S (cv y))) id C addeq2cd
       eqeqN12a allarl all-l (=N B C) bibi1d exp pm5.74d
         (=N (cv x) A) id B addeq2cd
           (=N (cv x) A) id C addeq2cd
         eqeqN12a allarl all-l (=N B C) bibi1d exp pm5.74d
           B eqNid pa-ax3cd
             C eqNid pa-ax3cd
           eqeqN12a
             (: B (N.T)) id (: (cv y) (N.T)) id pa-ax4Na
               (: C (N.T)) id (: (cv y) (N.T)) id pa-ax4Na
             eqeqN12a alrarr alr-r
               B (cv y) +:N C (cv y) +:N pa-ax2Na alrarr alr-r
             bitr4d al-r (=N B C) bibi1d exp pm5.74d biimprd
   findsN imp
))



