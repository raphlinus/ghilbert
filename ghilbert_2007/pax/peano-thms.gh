       (=N (cv x) (S (cv y))) id B muleq1cd
         (=N (cv x) (S (cv y))) id B muleq2cd
       eqeqN12d exp pm5.74d
         (=N (cv x) A) id B muleq1cd (=N (cv x) A) id B muleq2cd eqeqN12d exp pm5.74d
           (: B (N.T)) id pa-ax5rNd
           (: B (N.T)) id pa-ax5Nd eqNtr4d
             (: (cv y) (N.T)) id (: B (N.T)) id pa-ax6rNa
               (=N (* (cv y) B) (* B (cv y))) id
               B eqNid addeq12ca
             eqNtra alrarr
               (: B (N.T)) id (: (cv y) (N.T)) id pa-ax6Na al-r
             eqNtr4a allar
             exp31 a2d
   findsN imp
   df-=Nad pm3.27d
))

