thm ($pa_ax1 () ()
  (-> ($: A ($N.T)) (-. ($= ($N.T) ($0) ($S A))))
  (
   A ($N.T) df-ty2 df-$N.T A eleq2i bitr
   A peano3nn0 sylbi
     0nnn
   jctir
   (opr A (+) (1)) (NN) (0) nelneq syl
     ($N.T) (0) ($S A) df-$= A df-$S (0) eqeq2i bitr (0) (opr A (+) (1)) eqcom bitr
   negbii sylibr
))

export (PEANO pax/peano (PROP PRED) "$")
