     B C x df-un
   elab2g
     a (u. B C) elty pm3.26d
       a B elty pm3.26d a C elty pm3.26d jaoi
     pm5.21ni
   pm2.61i
))

thm (uneqri ((A x) (B x) (C x))
  ((uneqri.1 (<-> (\/ (e. (cv x) A) (e. (cv x) B)) (e. (cv x) C))))
  (-> (: C (*T)) (= (*T) (u. A B) C))
