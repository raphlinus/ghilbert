   A B df-$+ 
     A cast-ty B cast-ty nn0addcl
   eqeltr
))

thm ($pa_ax3 () ()
  ($= ($+ A ($0)) A)
  (
   A ($0) addty ($+ A ($0)) cast-ax ax-mp
     A ($0) df-$+
       df-$0 ($0) (0) casteq ax-mp 0nn0 (0) cast-ax ax-mp eqtr
       (castN A) (+) opreq2i
       A cast-ty nn0cn addid1 eqtr
     eqtr
   eqtr
   ($+ A ($0)) A df-$= mpbir
))

thm (sucequiv () ()
  (-> (e. A (NN0)) (= (opr A (+) (1)) ($S A)))
  (A cast-ax (+) (1) opreq1d
   A df-$S syl5req
))

thm (sucequivi ()
  ((hyp1 (e. A (NN0))))
  (= (opr A (+) (1)) ($S A))
