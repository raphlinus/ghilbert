  (hyp1 hyp2 A B addequiv mp2an))

thm ($pa_ax4 () ()
  ($= ($+ A ($S B)) ($S ($+ A B)))
  (
   A ($S B) df-$+ 
     A B df-$+ (+) (1) opreq1i
     A B addty sucequivi eqtr3
       A cast-ty nn0cn B cast-ty nn0cn 1cn addass
     eqtr3
       B sucty ($S B) cast-ax ax-mp B df-$S eqtr
       (castN A) (+) opreq2i
     eqtr4
   eqtr4
   eqimpi
))

thm (mulequiv () ()
  (-> (/\ (e. A (NN0)) (e. B (NN0))) (= (opr A (x.) B) ($* A B)))
  (
   A cast-ax (e. B (NN0)) adantr
     B cast-ax (e. A (NN0)) adantl
   (x.) opreq12d
