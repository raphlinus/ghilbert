thm ($pa_ind ((x y) (ph y)) ()
  (-> (/\ ($A. x (-> ($= ($cv x) ($0)) ph))
        ($A. y (-> ($A. x (-> ($= ($cv x) ($cv y)) ph))
                  ($A. x (-> ($= ($cv x) ($S ($cv y))) ph)))))
    ($A. x ph))
  (
   x (-> ($= (cv x) ($0)) ph) hba1
     x (-> ($= (cv x) (cv y)) ph) hba1
       x (-> ($= (cv x) ($S (cv y))) ph) hba1
     hbim y hbal
   hban

     0nn0
       df-$0 eqcomi (e. (0) (NN0)) a1i
         (e. (0) (NN0)) id
        x ph pa_indlem4
     mpan ibir
       (cv y) eqid (e. (cv y) (NN0)) a1i
         (e. (cv y) (NN0)) id
       x ph pa_indlem4
         (cv y) cast-ax (+) (1) opreq1d
         (cv y) df-$S syl5eq eqcomd
           1nn0 (cv y) (1) nn0addclt mpan2
         x ph pa_indlem4
       imbi12d
         x (NN0) ph ssrab2 (cv y) sseli
       pa_indlem6 imp
     anim12i anabss5
     nn0ex x ph rabex 0z y z peano5uz syl
       z nn0zrab ({e.|} x (NN0) ph) sseq1i
     sylibr
     (cv x) sseld
       x (NN0) ph rabid (e. (cv x) (NN0)) imbi2i
     sylib imp pm3.27d ex
   19.21ai ex
     x ph pa_indlem5
   sylibrd imp
))

