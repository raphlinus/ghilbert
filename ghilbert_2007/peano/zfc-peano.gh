# A construction of peano_r in ZFC

import (PROP pax/prop () "")
import (SET_MM_AX zfc/set_mm_ax (PROP) "")
import (SET_MM zfc/set_mm (PROP SET_MM_AX) "")

kindbind ( class $num )
kindbind ( set $var )

var (wff ph ps ch th ta et)
var (set w x y z)
var ($num A B C D F G)
var ($var a b c d)

def (($cv x) (cv x))
thm (df-$cv () ()
  (= ($cv x) (cv x))
  ((cv x) eqid))

def (($nfi x ph) (-> ph (A. x ph)))
thm (df-$nfi () ()
  (<-> ($nfi x ph) (-> ph (A. x ph)))
  ((-> ph (A. x ph)) pm4.2))

def (($A. x ph) (A. x ph))
thm (df-$A. () ()
  (<-> ($A. x ph) (A. x ph))
  ((A. x ph) pm4.2))

def ((castN A) (if (e. A (NN0)) A (0)))
thm (df-castN () ()
  (= (castN A) (if (e. A (NN0)) A (0)))
  ((if (e. A (NN0)) A (0)) eqid))

def (($= A B) (= (castN A) (castN B)))
thm (df-$= () ()
  (<-> ($= A B) (= (castN A) (castN B)))
  ((= (castN A) (castN B)) pm4.2))

thm ($ax-nfidv ((ph x)) ()
  ($nfi x ph)
  (ph x ax-17 x ph df-$nfi mpbir))

thm ($ax-nfinot ()
  ((hyp ($nfi x ph)))
  ($nfi x (-. ph))
