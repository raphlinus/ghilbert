   hyp2 A (NN0) x ph pa_indlem2 syl
     hyp1 A B (cv x) eqeq2 ph imbi1d x albidv syl
   bitrd
   (A. x (-> ($= (cv x) ($0)) ph)) adantr
     B x ph pa_indlem3
     hyp2 hyp1 (NN0) eleq1d mpbid sylan
   bitr4d
))

