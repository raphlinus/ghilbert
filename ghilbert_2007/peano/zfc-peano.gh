thm (eqequiv () ()
  (-> (/\ (e. A (NN0)) (e. B (NN0)))
    (<-> (= A B) ($= A B)))
  (A cast-ax B cast-ax eqeqan12d
     A B df-$=
   syl5rbb
))

thm (eqequivi ()
  ((hyp1 (e. A (NN0)))
   (hyp2 (e. B (NN0))))
