# Some basic defs that could be in their own module, but are convenient here.

def ( ( $! T )
  ( lambda f ( $-> T ( bool ) )
    ( . ( . ( $= ( $-> T ( bool ) ) ) ( var f ( $-> T ( bool ) ) ) )
        ( lambda x T ( true ) ) ) ) )

thm (.eq1d ()
  ((hyp (-> ph (= F G))))
  (-> ph (= (. F A) (. G A)))
  (hyp F G A .eq1 syl))

thm (.eq2d ()
  ((hyp (-> ph (= A B))))
  (-> ph (= (. F A) (. F B)))
  (hyp A B F .eq2 syl))

thm (df-$!-half ((T f g x y)) ()
  (= (lambda f ($-> T (bool)) (. (. ($= ($-> T (bool))) (var f ($-> T (bool))))
                                 (lambda x T (true))))
     (lambda g ($-> T (bool)) (. (. ($= ($-> T (bool))) (var g ($-> T (bool))))
                                 (lambda y T (true)))))
  (
   f g ($-> T (bool)) vareq1
   ($= ($-> T (bool))) .eq2d
   (lambda x T (true)) .eq1d
     (true) eqid (= (cv x) (cv y)) a1i T alphaconv
     (. ($= ($-> T (bool))) (var g ($-> T (bool)))) .eq2i
   syl6eq
   ($-> T (bool)) alphaconv
))

