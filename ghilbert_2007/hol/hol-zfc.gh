#    ph C A iffalse ph C B iffalse eqtr3d A B = a1d pm2.61i
#) )

thm ( ifeq1i ( )
  ( ( hyp ( = A B ) ) )
  ( = ( if ph A C ) ( if ph B C ) )
  ( hyp A B ph C ifeq1 ax-mp ) )

#thm ( ifeq2 ( ) ( )
