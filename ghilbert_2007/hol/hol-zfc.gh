thm ( bisbc ( )
  ( ( hyp.1 ( e. A ( V ) ) )
    ( hyp.2 ( <-> ph ps ) ) )
  ( <-> ( [/] A x ph ) ( [/] A x ps ) )
  ( hyp.1 hyp.2 x sbctru
    hyp.1 x ph ps sbcb mpbi
) )

thm ( bisbcd ( )
  ( ( hyp.1 ( e. A ( V ) ) )
    ( hyp.2 ( -> ph ( A. x ph ) ) )
    ( hyp.3 ( -> ph ( <-> ps ch ) ) ) )
  ( -> ph ( <-> ( [/] A x ps ) ( [/] A x ch ) ) )
