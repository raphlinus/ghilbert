thm (iota_ax ((T f x y))
  ((hyp (istype T)))
  ($|- (true) (. ($! ($-> T (bool))) (lambda f ($-> T (bool))
    (. ( . ($==>)
      (. ($~) (. ($! T) (lambda x T (. ($~) (. (var f ($-> T (bool))) (var x T)))))))
