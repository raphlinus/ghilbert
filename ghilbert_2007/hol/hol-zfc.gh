  ( ( hyp ( e. A ( V ) ) ) )
  ( <-> ( [/] A x ( -> ph ps ) ) ( -> ( [/] A x ph ) ( [/] A x ps ) ) )
  ( hyp

    (cv y) A x (-> ph ps) dfsbcq
    y x ph ps sbim syl5bbr
    (cv y) A x ph dfsbcq (cv y) A x ps dfsbcq imbi12d bitr3d
    vtocle
) )

thm ( sbca ( ( A y ) ( x y ) ( ph y ) ( ps y ) )
  ( ( hyp ( e. A ( V ) ) ) )
