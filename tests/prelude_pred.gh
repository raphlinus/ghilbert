/* Predicate calculus, in the style of set.mm's ax-gen..ax-12, with the
   free-variable conventions of this verifier: `x F/ ph` means x does not
   occur free in ph; bound variables in a statement are pairwise distinct;
   term variables (including those of kind val) may contain any bound
   variable free unless a F/ constraint says otherwise. */
syntax {
    binder A. 45;
    binder E. 45;
}
term A. (val->wff): wff;
bound x y z w: val;
var a b c: val;
term = val val: wff;

axiom ax-gen (ph): A. x ph;
axiom ax-4: A. x (ph -> ps) -> A. x ph -> A. x ps;
axiom ax-5 x F/ ph: ph -> A. x ph;
axiom sp: A. x ph -> ph;
axiom ax-6 x F/ a: -. A. x -. x = a;
axiom ax-7: a = b -> a = c -> b = c;
axiom ax-10: -. A. x ph -> A. x -. A. x ph;
axiom ax-11: A. x A. y ph -> A. y A. x ph;
axiom ax-12 x F/ a: x = a -> ph -> A. x (x = a -> ph);

def E. (\ x ph): -. A. x -. ph;

theorem alimi (h: ph -> ps): A. x ph -> A. x ps ::(ax-mp (ax-gen h) ax-4)
theorem eximi (h: ph -> ps): E. x ph -> E. x ps ::(con3i (alimi (con3i h)))
theorem 19.8a: ph -> E. x ph ::(con2i sp)
theorem 19.9 x F/ ph: E. x ph -> ph ::(con1i ax-5)
