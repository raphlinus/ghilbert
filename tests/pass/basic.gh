/* equid needs a dummy bound variable that never appears in the statement */
theorem equid: a = a {
    l1: ax-6
    [E. x x = a]
    ax-mp l1 (eximi (pm2.43i ax-7))
    [E. x a = a]
    ax-mp _ 19.9
}
theorem alcom: A. x A. y ph -> A. y A. x ph {ax-11}
theorem hbe1: E. x ph -> A. x E. x ph {ax-10}
theorem a17d x F/ ps: ph -> ps -> A. x ps {a1i ax-5}
theorem 19.3 x F/ ph: A. x ph -> ph {sp}
theorem stdpc4ish: A. x (x = a -> ph) -> x = a -> ph {sp}
/* result line introducing a fresh bound variable name */
theorem rl: ph -> ph {
    l1: 19.8a
    [ph -> E. z ph]
    l2: 19.9
    [E. z ph -> ph]
    syl l1 l2
}
