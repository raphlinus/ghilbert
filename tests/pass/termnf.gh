/* F/ with a term variable on the left: for variables, "a not free in b"
   means a and b differ. */
axiom neq a F/ b: -. a = b;
theorem ok1 a F/ b: -. a = b ::(neq)
theorem ok2: -. x = y ::(neq)
theorem ok3 x F/ a: -. x = a ::(neq)
theorem ok4 x F/ a: -. a = x ::(neq)
theorem ok5 a F/ b: -. b = a ::(neq)
